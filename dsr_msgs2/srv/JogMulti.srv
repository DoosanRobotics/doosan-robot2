#____________________________________________________________________________________________
# multi jog speed = (250mm/s / sqrt(3)) x unit vector x speed [%] 
#____________________________________________________________________________________________

float64[6] jog_axis    # unit vector of Task space [Tx, Ty, Tz, Rx, Ry, Rz] : -1.0 ~ +1.0; only Tx, Ty, Tz are used, Rx, Ry, Rz are ignored 
int16 move_reference    # 0 : MOVE_REFERENCE_BASE, 1 : MOVE_REFERENCE_TOOL, 2 : MOVE_REFERENCE_WORLD
float64 speed          # jog speed [%]  
---
bool success
