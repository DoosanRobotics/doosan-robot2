#____________________________________________________________________________________________
# get_current_tool_flange_posx()  
#____________________________________________________________________________________________
# This service returns the pose of the current tool flange in the BASE coordinate. In other words, it means the return to tcp=(0,0,0,0,0,0).

int16       ref               # ignored; the pose is always in DR_BASE(0)
---
float64[6]  pos               # Pose of tool flange(posx) 
bool        success